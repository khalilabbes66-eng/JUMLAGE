---
import { workPackages } from '../../i18n/homepage';
import { home, localizedPath, type Locale } from '../../i18n/navigation';
import { projectPageCopy, projectSectionOrder } from '../../i18n/project';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InternalContentSection from '../sections/InternalContentSection.astro';
import Container from '../ui/Container.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import InternalPageHero from './InternalPageHero.astro';
import PageContents from './PageContents.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const page = projectPageCopy[locale];
const sections = projectSectionOrder.map((id) => ({ id, ...page.sections[id] }));
---

<BaseLayout {locale} title={page.title} description={page.intro}>
	<InternalPageHero heading={page.title} kicker={page.kicker} description={page.intro}>
		<Breadcrumbs
			slot="breadcrumbs"
			label={page.breadcrumbLabel}
			ancestors={[{ label: home[locale].label, href: localizedPath(locale) }]}
			current={page.title}
		/>
		<dl slot="summary" class="grid grid-cols-2 gap-x-4 gap-y-5 border-t-2 border-accent bg-primary p-4 text-surface sm:p-6">
			{page.facts.map(({ label, value }) => (
				<div class="min-w-0 border-t border-surface/30 pt-2">
					<dt class="text-xs font-semibold wrap-anywhere text-surface/90">{label}</dt>
					<dd class="mt-1 font-extrabold wrap-anywhere">{value}</dd>
				</div>
			))}
		</dl>
	</InternalPageHero>

	<div class="bg-surface">
		<Container class="editorial-grid py-block">
			<div class="min-w-0 md:col-span-12 lg:sticky lg:top-6 lg:col-span-4 lg:self-start lg:pe-grid">
				<PageContents label={page.contentsLabel} items={sections} />
			</div>
			<div class="min-w-0 md:col-span-12 lg:col-span-8">
				{sections.map(({ id, heading, paragraphs, pending }) => (
					<InternalContentSection
						{id}
						{heading}
						{paragraphs}
						pending={pending ? { label: page.pendingLabel, message: pending } : undefined}
					>
						{id === 'methodology' && (
							<ol class="divide-y divide-divider border-y border-divider" role="list">
								{workPackages.map((item) => (
										<li class="flex items-baseline gap-3 py-3">
											<span class="editorial-label shrink-0 text-muted">{item.code}</span>
											<span class="min-w-0 font-bold wrap-anywhere text-primary">{item[locale]}</span>
										</li>
									))}
							</ol>
						)}
					</InternalContentSection>
				))}
			</div>
		</Container>
	</div>
</BaseLayout>
