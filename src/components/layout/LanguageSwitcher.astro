---
import { languageNames, layoutText, locales, localizedPath, type Locale } from '../../i18n/navigation';

interface Props {
	locale: Locale;
	alternatePath?: string;
}

const { locale, alternatePath } = Astro.props;
const itemClass = 'tap-target inline-flex items-center justify-center px-1.5 text-xs font-bold sm:px-3 sm:text-sm';
---

<nav aria-label={layoutText[locale].languages}>
	<ul class="flex flex-wrap items-center" role="list">
		{locales.map((language) => (
			<li>
				{language === locale ? (
					<span lang={language} aria-current="true" class:list={[itemClass, 'text-primary underline decoration-accent decoration-2 underline-offset-5 forced-colors:decoration-current']}>
						<span aria-hidden="true" class="uppercase sm:hidden">{language}</span>
						<span class="sr-only sm:not-sr-only">{languageNames[language]}</span>
					</span>
				) : (
					<a
						href={alternatePath ?? localizedPath(language)}
						hreflang={language}
						class:list={[itemClass, 'interactive-color text-muted underline-offset-5 hover:bg-surface hover:text-primary hover:underline active:bg-primary/10']}
					>
						<span aria-hidden="true" class="uppercase sm:hidden">{language}</span>
						<span lang={language} class="sr-only sm:not-sr-only">{languageNames[language]}</span>
						{!alternatePath && <span class="sr-only"> ({layoutText[locale].languageHome[language]})</span>}
					</a>
				)}
			</li>
		))}
	</ul>
</nav>
