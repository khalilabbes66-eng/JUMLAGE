---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
	heading: string;
	placeholderLabel: string;
	emptyMessage: string;
	href: string;
	linkLabel: string;
}

const { heading, placeholderLabel, emptyMessage, href, linkLabel } = Astro.props;
---

<Section aria-labelledby="resources-title" class="border-t border-divider">
	<div class="editorial-grid">
		<div class="min-w-0 md:col-span-4">
			<SectionHeading headingId="resources-title" {heading} />
			<Button {href} variant="secondary" class="mt-5">{linkLabel}</Button>
		</div>
		<div class="min-w-0 md:col-span-8">
			<slot>
				<Card as="div">
					<Badge>{placeholderLabel}</Badge>
					<p class="mt-3 text-muted">{emptyMessage}</p>
				</Card>
			</slot>
		</div>
	</div>
</Section>
