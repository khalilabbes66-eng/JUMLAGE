---
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
	heading: string;
	description: string;
	href: string;
	linkLabel: string;
}

const { heading, description, href, linkLabel } = Astro.props;
---

<Section aria-labelledby="about-project-title" class="bg-surface">
	<div class="editorial-grid">
		<SectionHeading headingId="about-project-title" {heading} class="md:col-span-5" />
		<div class="min-w-0 max-w-prose md:col-span-7">
			<p class="text-body text-pretty">{description}</p>
			<Button {href} variant="secondary" class="mt-5">{linkLabel}</Button>
		</div>
	</div>
</Section>
