---
import type { NewsEntry } from '../../i18n/homepage';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
	heading: string;
	entries: readonly NewsEntry[];
	placeholderLabel: string;
	emptyMessage: string;
	href: string;
	linkLabel: string;
}

const { heading, entries, placeholderLabel, emptyMessage, href, linkLabel } = Astro.props;
---

<Section aria-labelledby="latest-news-title" class="border-t border-divider bg-surface">
	<div class="editorial-grid">
		<div class="min-w-0 md:col-span-4">
			<SectionHeading headingId="latest-news-title" {heading} />
			<Button {href} variant="secondary" class="mt-5">{linkLabel}</Button>
		</div>
		<div class="min-w-0 md:col-span-8">
			{entries.length > 0 ? (
				<ul class="grid gap-grid lg:grid-cols-2" role="list">
					{entries.map(({ title, href: articleHref, summary, date }) => (
						<li class="min-w-0">
							<Card class="h-full">
								{date && <time datetime={date.iso} class="editorial-label text-muted">{date.label}</time>}
								<h3 class="text-xl font-extrabold text-primary">
									<a href={articleHref} class="tap-target inline-flex items-center wrap-anywhere underline underline-offset-4 hover:decoration-2">{title}</a>
								</h3>
								{summary && <p class="mt-2 wrap-break-word text-muted">{summary}</p>}
							</Card>
						</li>
					))}
				</ul>
			) : (
				<Card as="div">
					<Badge>{placeholderLabel}</Badge>
					<p class="mt-3 text-muted">{emptyMessage}</p>
				</Card>
			)}
		</div>
	</div>
</Section>
