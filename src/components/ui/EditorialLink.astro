---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { href: string };
const { class: className, ...attributes } = Astro.props;
---

<a {...attributes} class:list={['tap-target interactive-color inline-flex max-w-full items-center text-sm font-bold wrap-anywhere text-primary underline underline-offset-4 hover:decoration-2', className]}>
	<slot />
</a>
