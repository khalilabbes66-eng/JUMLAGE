---
interface Props {
	heading: string;
	id: string;
}

const { heading, id } = Astro.props;
const headingId = id + '-title';
---

<section {id} aria-labelledby={headingId} tabindex="-1" class="min-w-0 scroll-mt-4 border-t border-divider pt-block pb-2">
	<h2 id={headingId} class="mb-5 text-heading font-extrabold wrap-anywhere text-primary">{heading}</h2>
	<slot />
</section>
